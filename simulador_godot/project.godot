; UxS Trainer (entrenador de sistemas no tripulados), version 2 (Godot 4). config/name sigue siendo el antiguo a
; proposito: de el sale la carpeta de datos del usuario (aula.cfg, simulador.cfg...) y cambiarlo los perderia. Los datos (aviones, mundos, zonas) son los de ../simulador/, comunes
; con la version 1 del navegador. Se lanza con:  herramientas/godot/Godot_v4.7.2-stable_win64.exe --path simulador_godot
config_version=5

[application]
config/name="Entrenador Vuelo RC v2 (Godot)"
run/main_scene="res://escenas/principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.78, 0.84, 0.9, 1)
