# salidas regenerables de los scripts (python scripts/geom_e1.py ...): mallas, pickles y STL intermedios
scripts/out/
scripts/out_*/
__pycache__/
*.pyc
# datos del aula (base de datos SQLite y copias) y registros de prueba
aula/datos/
aula_prueba/
# temporales
*.tmp
~$*
# salida regenerable del generador del T1 (python stl/T1/scripts/geom.py): las STL buenas van en stl/T1/stl/
stl/T1/scripts/out/
# Godot y otras herramientas descargadas (no van al repositorio)
herramientas/
# zonas de detalle de los mundos reales: se generan con analisis/mundo_cartagena/zona.py
simulador/zonas/
# cache de importacion de Godot (se regenera al abrir el proyecto)
simulador_godot/.godot/
